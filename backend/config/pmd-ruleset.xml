<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- Re-added below with project configuration (D2, D4). -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>
        <exclude name="GuardLogStatement"/>
    </rule>

    <!-- D2, narrowed: empty-constructor rules are not enforced on JPA entities. JPA requires every @Entity to
         have a no-argument constructor, and the @Entity annotation on the class already says why it is empty.
         Where it is the class's only constructor, keeping it explicit means a later constructor with arguments
         cannot silently remove it (Hibernate would then fail at runtime, when it loads a row, not at compile
         time). Non-entity classes stay enforced; their existing findings (PeerEvaluationAverage,
         WeeklyPeerEvaluationReport, RatingAverage, Result) remain in the baseline, untriaged. -->
    <rule ref="category/java/documentation.xml/UncommentedEmptyConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor::ClassDeclaration[pmd-java:hasAnnotation('jakarta.persistence.Entity')]"/>
        </properties>
    </rule>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor-or-self::ClassDeclaration[pmd-java:hasAnnotation('jakarta.persistence.Entity')]"/>
        </properties>
    </rule>

    <!-- D4, narrowed: guards are required only on trace and debug calls. No application*.yml sets
         logging.level, so every profile runs at Spring Boot's default INFO: info, warn, and error calls always
         execute and a guard can never skip them. Debug and trace are off by default, so a guard there skips
         argument evaluation that would otherwise be wasted. -->
    <rule ref="category/java/bestpractices.xml/GuardLogStatement">
        <properties>
            <property name="logLevels" value="trace,debug"/>
            <property name="guardsMethods" value="isTraceEnabled,isDebugEnabled"/>
        </properties>
    </rule>
</ruleset>
